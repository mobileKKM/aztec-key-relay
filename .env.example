# ── Upstream (Firebase) ──────────────────────────────────────────────────────
# The official mKKM app's identifiers (all ship inside the official APK —
# see mobile_kkm's ekp_crypto README for how to recover them). Required.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_ANDROID_PACKAGE=
FIREBASE_ANDROID_CERT=
FIREBASE_RC_SDK_VERSION=
FIREBASE_APP_BUILD=

# RC fetch body context (as sent by the captured official client).
FIREBASE_APP_VERSION=1.6.10
FIREBASE_COUNTRY_CODE=US
FIREBASE_PLATFORM_VERSION=34
FIREBASE_TIME_ZONE=Europe/Warsaw
FIREBASE_LANGUAGE_CODE=en-US
FIREBASE_USER_AGENT=Dalvik/2.1.0 (Linux; U; Android 14; Android SDK built for arm64 Build/UE1A.230829.036.A1)

# ── Service ──────────────────────────────────────────────────────────────────
# When set, API endpoints require "Authorization: Bearer <token>".
#RELAY_API_TOKEN=
# Minimum seconds between upstream fetch attempts (refresh endpoint enforces).
RELAY_MIN_FETCH_INTERVAL=60
# Cache-Control max-age (seconds) for GET /api/v1/aztec-key responses.
RELAY_CACHE_MAX_AGE=300
# Daily refresh time, UTC hours.
RELAY_DAILY_REFRESH_HOUR=4
# SQLite database file (inside the mounted ./data volume).
RELAY_DB_PATH=data/state.db
# Number of historical keys to keep.
RELAY_KEY_HISTORY=10
