# ── Upstream (Firebase) ──────────────────────────────────────────────────────
# All values below ship in the official APK (see mobile_kkm packages/ekp_crypto
# README); they identify the *app*, not any user.
FIREBASE_PROJECT_ID=PROJECT_ID
FIREBASE_APP_ID=APP_ID
FIREBASE_API_KEY=API_KEY
FIREBASE_ANDROID_PACKAGE=ANDROID_PACKAGE
FIREBASE_ANDROID_CERT=ANDROID_CERT
FIREBASE_RC_SDK_VERSION=23.0.0
FIREBASE_APP_BUILD=APP_BUILD

# ── Service ──────────────────────────────────────────────────────────────────
# When set, API endpoints require "Authorization: Bearer <token>".
#RELAY_API_TOKEN=
# Minimum seconds between upstream fetch attempts (refresh endpoint enforces).
RELAY_MIN_FETCH_INTERVAL=60
# Daily refresh time, UTC hours.
RELAY_DAILY_REFRESH_HOUR=4
# SQLite database file (inside the mounted ./data volume).
RELAY_DB_PATH=data/state.db
# Number of historical keys to keep.
RELAY_KEY_HISTORY=10
